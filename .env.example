# ===== Play Lap Game Agent Server — environment =====
# Copy to .env (or set as RunPod environment variables). NEVER bake secrets into the Docker image.

# --- Required ---
# API key clients must send as: Authorization: Bearer <key>
PLAYLAP_AGENT_API_KEY=change-me-to-a-long-random-string

# --- Server ---
PORT=8700
# Directory roots (inside Docker these default to /workspaces and /data volumes)
WORKSPACES_DIR=./workspaces
DATA_DIR=./data

# --- Model provider: mock | openai-compatible | local ---
# mock              → deterministic built-in provider (testing, no GPU / no API needed)
# openai-compatible → any OpenAI-compatible endpoint (set MODEL_BASE_URL / MODEL_API_KEY)
# local             → the llama.cpp server started inside the Docker image (Qwen3-Coder 30B)
MODEL_PROVIDER=mock
MODEL_NAME=qwen3-coder-30b-a3b-instruct
# For openai-compatible (and overridable for local, default http://127.0.0.1:8080/v1):
MODEL_BASE_URL=
MODEL_API_KEY=
# Context / generation limits sent to the model
MODEL_MAX_TOKENS=8192

# --- Local model download (Docker startup only) ---
# GGUF quantization that fits 24GB VRAM (RTX 4090). See RUNPOD_DEPLOYMENT.md.
MODEL_GGUF_URL=https://huggingface.co/unsloth/Qwen3-Coder-30B-A3B-Instruct-GGUF/resolve/main/Qwen3-Coder-30B-A3B-Instruct-Q4_K_M.gguf
MODELS_DIR=/models
CACHE_DIR=/cache
LLAMA_CTX_SIZE=32768
LLAMA_GPU_LAYERS=999

# --- Agent limits ---
MAX_CONCURRENT_JOBS=1
MAX_BUILD_ITERATIONS=3
MAX_REPAIR_ITERATIONS=3
JOB_TIMEOUT_MINUTES=25
MAX_WORKSPACE_MB=200
MAX_QUEUE_LENGTH=20

# --- Rate limiting ---
RATE_LIMIT_WINDOW_SECONDS=60
RATE_LIMIT_MAX_REQUESTS=120

# --- Playwright (Replit dev only; leave empty in Docker) ---
# PLAYWRIGHT_CHROMIUM_PATH=

# Dev-only escape hatch when the Chromium sandbox cannot start (e.g. Replit/NixOS). NEVER in production.
# CHROMIUM_NO_SANDBOX=1
