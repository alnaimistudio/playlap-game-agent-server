# ===== LOCAL_WINDOWS preset =====
# Windows 11 + WSL2 + Docker Desktop + RTX 4090 + Ollama on the Windows host.
# Copy this file to .env, then run:  docker compose up --build

# API key clients must send as: Authorization: Bearer <key>
# Fine as a local dev value; MUST be replaced before exposing the server online.
PLAYLAP_AGENT_API_KEY=change-this-before-exposing-online

PORT=8000

# Model runs OUTSIDE Docker, on Windows Ollama (OpenAI-compatible /v1 API).
MODEL_PROVIDER=openai-compatible
MODEL_BASE_URL=http://host.docker.internal:11434/v1
MODEL_NAME=qwen3-coder:30b
MODEL_MAX_TOKENS=8192

MAX_CONCURRENT_JOBS=1
MAX_BUILD_ITERATIONS=3
MAX_REPAIR_ITERATIONS=3
JOB_TIMEOUT_MINUTES=30
